{
  "name": "slitherlink3d",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"js/tests/*.test.js\"",
    "test:mobile": "playwright test --config=js/tests/mobile/playwright.config.js",
    "test:links": "SLI_CHECK_LINKS=1 node --test js/tests/polyhedronLinks.test.js",
    "test:links:all": "SLI_CHECK_LINKS=1 SLI_CHECK_ALL_LINKS=1 node --test js/tests/polyhedronLinks.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}

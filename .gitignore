# Node dev dependencies (only @playwright/test, for `npm run test:mobile`;
# the app itself ships no dependencies). package-lock.json IS committed, so
# the pinned version is reproducible.
node_modules/

# Playwright output: traces, screenshots and reports from failing runs.
test-results/
playwright-report/

# Python virtual environment for the util/ tools (requirements.txt says how to
# make one). __pycache__ is covered by the global gitignore, so it isn't here.
.venv/
venv/
